@model IEnumerable<DisasterRelief.Models.Donation>
@{
    ViewData["Title"] = "Dashboard";
    var totals = ViewBag.TotalsByCurrency as Dictionary<string, decimal> ?? new();
    var myDonations = ViewBag.MyDonations as List<DisasterRelief.Models.Donation> ?? new();
}

<div class="max-w-5xl mx-auto p-6 mt-10">
    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">

        <!-- Header Section -->
        <div class="bg-[#1b3a2b] text-white p-8">
            <h1 class="text-3xl font-serif font-bold tracking-wide">Operations Center</h1>
            <p class="mt-2 text-green-100 opacity-90 text-sm">
                Status: @(User.IsInRole("Employee") ? "Employee Administrator" : "Verified Donor") | User: <span class="font-semibold">@User.Identity?.Name</span>
            </p>
        </div>

        <div class="p-8">
            @if (TempData["DashboardMessage"] != null)
            {
                <div class="mb-6 bg-green-50 border border-green-300 text-green-900 rounded-xl px-6 py-4 font-medium">@TempData["DashboardMessage"]</div>
            }

            @if (User.IsInRole("Employee"))
            {
                <!-- EMPLOYEE VIEW: Financials & Data -->
                <div class="space-y-8">

                    <div class="flex justify-end">
                        <a id="post-update" asp-controller="Updates" asp-action="Create" class="bg-[#1b3a2b] text-white px-6 py-3 rounded-lg font-medium shadow-md hover:shadow-lg transition-all">+ Post an Update</a>
                    </div>

                    <!-- Total Donations Stats Card -->
                    <div class="bg-green-50 p-6 rounded-xl border border-green-200 shadow-sm flex items-center justify-between">
                        <div>
                            <h2 class="text-xl font-bold text-[#1b3a2b]">Total Platform Contributions</h2>
                            <p class="text-sm text-gray-600">Cumulative sum of all verified donations.</p>
                            <p class="text-xs text-gray-500 mt-2">
                                @foreach (var t in totals.Where(t => t.Key != "ZAR"))
                                {
                                    <span class="mr-4">@t.Key @t.Value.ToString("0.00")</span>
                                }
                            </p>
                        </div>
                        <div class="text-4xl font-bold text-[#1b3a2b]">
                            R @(((decimal)ViewBag.TotalSum).ToString("0.00"))
                        </div>
                    </div>

                    <!-- Donor History Table -->
                    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
                        <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                            <h3 class="font-bold text-[#1b3a2b]">Recent Donor Activity</h3>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm">
                                <thead class="bg-gray-100 text-gray-600">
                                    <tr>
                                        <th class="px-6 py-3 font-semibold">Donor Name</th>
                                        <th class="px-6 py-3 font-semibold">Type</th>
                                        <th class="px-6 py-3 font-semibold">Frequency</th>
                                        <th class="px-6 py-3 font-semibold text-right">Amount</th>
                                        <th class="px-6 py-3 font-semibold">Certificate</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    @foreach (var donation in Model)
                                    {
                                        <tr class="hover:bg-gray-50 transition-colors">
                                            <td class="px-6 py-4 font-medium text-gray-900">@donation.DonorName</td>
                                            <td class="px-6 py-4 text-gray-600">@donation.DonationType</td>
                                            <td class="px-6 py-4 text-gray-600">@donation.Frequency</td>
                                            <td class="px-6 py-4 font-bold text-green-700 text-right">@donation.Currency @donation.Amount.ToString("0.00")</td>
                                            <td class="px-6 py-4"><a class="underline text-[#1b3a2b]" asp-controller="Certificates" asp-action="Show" asp-route-id="@donation.Id">View</a></td>
                                        </tr>
                                    }
                                    @if (!Model.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="px-6 py-8 text-center text-gray-500 italic">No donations recorded yet.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- STANDARD DONOR VIEW -->
                <div class="space-y-8">
                    <div class="bg-gray-50 p-6 rounded-xl border border-gray-200 shadow-sm flex flex-col sm:flex-row justify-between items-center gap-4">
                        <div>
                            <h2 class="text-xl font-bold text-[#1b3a2b] mb-2">Donor Portal</h2>
                            <p class="text-gray-600 text-sm">Thank you for standing with us. Download a tax certificate for any donation below.</p>
                        </div>
                        <a href="/#donate" class="bg-[#1b3a2b] text-white px-6 py-3 rounded-lg font-medium shadow-md hover:shadow-lg transition-all">
                            Make a Contribution
                        </a>
                    </div>

                    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
                        <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                            <h3 class="font-bold text-[#1b3a2b]">My Donations</h3>
                        </div>
                        <table class="w-full text-left text-sm">
                            <thead class="bg-gray-100 text-gray-600">
                                <tr>
                                    <th class="px-6 py-3 font-semibold">Date</th>
                                    <th class="px-6 py-3 font-semibold">Frequency</th>
                                    <th class="px-6 py-3 font-semibold text-right">Amount</th>
                                    <th class="px-6 py-3 font-semibold">Tax Certificate</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                @foreach (var donation in myDonations)
                                {
                                    <tr>
                                        <td class="px-6 py-4">@donation.DateDonated.ToString("dd MMM yyyy")</td>
                                        <td class="px-6 py-4">@donation.Frequency</td>
                                        <td class="px-6 py-4 text-right font-bold">@donation.Currency @donation.Amount.ToString("0.00")</td>
                                        <td class="px-6 py-4 space-x-3">
                                            <a class="underline" asp-controller="Certificates" asp-action="Show" asp-route-id="@donation.Id">View</a>
                                            <a class="underline" asp-controller="Certificates" asp-action="Download" asp-route-id="@donation.Id">Download</a>
                                        </td>
                                    </tr>
                                }
                                @if (!myDonations.Any())
                                {
                                    <tr><td colspan="4" class="px-6 py-8 text-center text-gray-500 italic">You haven't made a donation while logged in yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
