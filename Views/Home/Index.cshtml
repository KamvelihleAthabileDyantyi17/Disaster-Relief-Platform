@{
    ViewData["Title"] = "Home Page";
}
<!-- CI Pipeline Test -->
<div class="bg-[#f9f8f6] text-[#1b3a2b] font-sans min-h-screen">
    <!-- Hero Section -->
    <header class="max-w-7xl mx-auto px-6 py-12 flex justify-between items-center">
        <div class="flex items-center gap-3">
            <img src="~/images/GiftofTheGivers_logo.png" alt="Gift of the Givers" class="h-10 w-10 object-contain">
            <span class="font-serif text-xl font-bold tracking-tight">Gift of the Givers</span>
        </div>
        <nav class="hidden md:flex gap-8 text-sm font-medium">
            <a href="#about" class="hover:opacity-70 transition">About</a>
            <a href="#donate" class="hover:opacity-70 transition">Donate</a>
            <a href="#volunteer" class="hover:opacity-70 transition">Volunteer</a>
        </nav>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-12">
        <div class="text-center max-w-3xl mx-auto mb-12">
            <h1 class="font-serif text-5xl md:text-6xl tracking-tight mb-6">Provide relief. Restore hope.</h1>
            <p class="text-gray-600 text-lg leading-relaxed">Disaster response, hunger alleviation, and human development delivered with dignity and immediate impact across communities.</p>
        </div>

        @if (TempData["DonationMessage"] != null)
        {
            <div id="donation-message" class="max-w-3xl mx-auto mb-8 bg-green-50 border border-green-300 text-green-900 rounded-xl px-6 py-4 text-center font-medium">
                @TempData["DonationMessage"]
            </div>
        }

        <!-- Latest updates posted by employees -->
        <section id="updates" class="max-w-3xl mx-auto mb-16">
            <h2 class="font-serif text-3xl mb-6 text-center">Latest Updates</h2>
            @{ var updates = ViewBag.Updates as List<DisasterRelief.Models.ReliefUpdate> ?? new(); }
            @if (!updates.Any())
            {
                <p class="text-center text-gray-500 italic">No updates have been posted yet.</p>
            }
            <div class="space-y-4">
                @foreach (var u in updates)
                {
                    <article class="update-item bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
                        <h3 class="font-serif text-xl mb-1">@u.Title</h3>
                        <p class="text-xs text-gray-500 mb-3">@u.DatePosted.ToString("dd MMM yyyy, HH:mm")</p>
                        <p class="text-gray-700 text-sm leading-relaxed whitespace-pre-line">@u.Message</p>
                    </article>
                }
            </div>
        </section>

        <!-- ========================================== -->
        <!-- PROOF OF NUGET PACKAGE (TAX SIMULATOR)     -->
        <!-- ========================================== -->
        <div class="max-w-3xl mx-auto mb-16 bg-[#1b3a2b] text-[#f9f8f6] rounded-2xl p-6 text-center shadow-lg border border-[#eef2ed]">
            <h3 class="font-serif text-2xl mb-2">Tax Deduction Simulator</h3>
            <p class="text-gray-300 text-sm mb-4">Based on a simulated total donation pool of R50,000:</p>
            <h4 class="text-xl">Calculated 18% Tax Deduction: <strong class="text-white bg-white/20 px-3 py-1 rounded-lg">R @ViewBag.TaxDeductibleValue</strong></h4>
        </div>
        <!-- ========================================== -->
        <!-- Volunteer Section Form -->
        <section id="volunteer" class="bg-[#eef2ed] rounded-[2.5rem] p-8 md:p-16 mb-16">
            <div class="max-w-xl mx-auto">
                <h2 class="font-serif text-3xl mb-4 text-center">Become a Volunteer</h2>
                <p class="text-gray-600 text-center mb-8 text-sm">Join our network of skilled responders ready to act when disaster strikes.</p>

                <form asp-controller="Volunteers" asp-action="Register" method="post" class="space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider mb-1">First Name</label>
                            <input type="text" name="FirstName" required class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#1b3a2b]">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Last Name</label>
                            <input type="text" name="LastName" required class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#1b3a2b]">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Email Address</label>
                        <input type="email" name="EmailAddress" required class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#1b3a2b]">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Phone Number</label>
                        <input type="text" name="PhoneNumber" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#1b3a2b]">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Specialized Skills</label>
                        <input type="text" name="SpecializedSkills" placeholder="e.g. Medical, Logistics, Engineering" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#1b3a2b]">
                    </div>
                    <button type="submit" class="w-full bg-[#1b3a2b] text-white py-4 rounded-xl font-medium hover:bg-opacity-90 transition mt-4">Register as Volunteer</button>
                </form>
            </div>
        </section>

        <!-- Donation & Impact Tracker Section -->
        <section id="donate" class="bg-[#1b3a2b] text-[#f9f8f6] rounded-[2.5rem] p-8 md:p-16 mb-16">
            <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <div>
                    <h2 class="font-serif text-4xl mb-4">Real-Time Impact Tracker</h2>
                    <p class="text-gray-300 text-sm leading-relaxed mb-6">Every contribution goes directly toward critical disaster relief operations, medical supply procurement, and emergency food security distribution.</p>

                    <div class="grid grid-cols-2 gap-6 border-t border-white/20 pt-6">
                        <div>
                            <span class="block font-serif text-3xl font-bold">R1.2M+</span>
                            <span class="text-xs uppercase tracking-wider text-gray-300">Relief Funds Raised</span>
                        </div>
                        <div>
                            <span class="block font-serif text-3xl font-bold">4,500+</span>
                            <span class="text-xs uppercase tracking-wider text-gray-300">Volunteers Active</span>
                        </div>
                    </div>
                </div>

                <div class="bg-[#f9f8f6] text-[#1b3a2b] p-8 rounded-3xl">
                    <h3 class="font-serif text-2xl mb-4">Make a Donation</h3>
                    <p class="text-xs text-gray-500 mb-4">Log in first if you want a tax certificate for this donation.</p>
                    <form asp-controller="Donations" asp-action="Create" method="post" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Donor Name / Organization</label>
                            <input type="text" name="DonorName" placeholder="Leave empty to give anonymously" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#1b3a2b]">
                        </div>
                        <label class="flex items-center gap-2 text-sm">
                            <input type="checkbox" name="IsAnonymous" value="true" id="IsAnonymous">
                            Donate anonymously (hide my name)
                        </label>
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Contribution Amount</label>
                            <div class="flex gap-2">
                                <select name="Currency" id="Currency" class="bg-white border border-gray-300 rounded-xl px-3 py-3 text-sm focus:outline-none focus:border-[#1b3a2b]">
                                    <option value="ZAR">ZAR (R)</option>
                                    <option value="USD">USD ($)</option>
                                    <option value="GBP">GBP (£)</option>
                                    <option value="EUR">EUR (€)</option>
                                </select>
                                <input type="number" step="0.01" min="1" name="Amount" required class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#1b3a2b]">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider mb-1">How often?</label>
                            <select name="Frequency" id="Frequency" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#1b3a2b]">
                                <option value="Once-off">Once-off donation</option>
                                <option value="Monthly">Monthly (recurring)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Donation Type</label>
                            <select name="DonationType" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#1b3a2b]">
                                <option value="Financial">Financial Support</option>
                                <option value="Medical">Medical Supplies</option>
                                <option value="Food">Food Parcels</option>
                            </select>
                        </div>
                        <button type="submit" class="w-full bg-[#1b3a2b] text-white py-4 rounded-xl font-medium hover:bg-opacity-90 transition mt-2">Submit Contribution</button>
                    </form>
                </div>
            </div>
        </section>
    </main>
</div>