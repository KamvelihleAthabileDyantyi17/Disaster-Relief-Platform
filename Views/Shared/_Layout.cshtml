<!DOCTYPE html>
<html lang="en">
<head>
    <script src="https://cdn.tailwindcss.com"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DisasterRelief</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DisasterRelief.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="flex justify-between items-center p-6 max-w-7xl mx-auto">
            <!-- Logo -->
            <a href="/" class="flex items-center gap-3">
                <img src="~/images/GiftofTheGivers_logo.png" alt="Gift of the Givers Logo" class="h-10 w-auto" />
                <span class="font-serif text-2xl font-bold text-[#1b3a2b]">DisasterRelief</span>
            </a>

            <div class="flex gap-6 items-center text-sm font-medium">
                <a href="/" class="hover:text-gray-500">Home</a>
                <a href="/Dashboard" class="hover:text-gray-500">Dashboard</a>

                <!-- Authentication UI Hooks -->
                @if (User.Identity.IsAuthenticated)
                {
                <span class="text-gray-500">Hello, @User.Identity.Name</span>
                <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" class="inline">
                    <button type="submit" class="hover:text-red-500">Logout</button>
                </form>
                }
                else
                {
                <a href="/Identity/Account/Login" class="hover:text-gray-500">Employee Login</a>
                <a href="/Identity/Account/Register" class="bg-[#1b3a2b] text-white px-5 py-2 rounded-full">Donor Register</a>
                }
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="max-w-7xl mx-auto px-6 py-12 border-t border-gray-200 text-sm text-gray-500 flex flex-col md:flex-row justify-between items-center gap-4">
        <p>&copy; 2026 Disaster Relief Platform. Built for community resilience and emergency response.</p>
        <div class="flex gap-6">
            <a href="#volunteer" class="hover:underline">Volunteer</a>
            <a href="#donate" class="hover:underline">Donate</a>
            <a href="#" class="hover:underline">Privacy Policy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>